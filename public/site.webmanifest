{
  "name": "FrameToque",
  "short_name": "FrameToque",
  "description": "A modern visual storytelling platform built for the future.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "lang": "en",
  "dir": "ltr",
  
  "icons": [
    { "src": "/favicon-16x16.png", "sizes": "16x16", "type": "image/png" },
    { "src": "/favicon-32x32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "/favicon-96x96.png", "sizes": "96x96", "type": "image/png" },
    { "src": "/favicon-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/favicon-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],

  "screenshots": [
    {
      "src": "/screenshots/shot1.png",
      "sizes": "1442x3202",
      "type": "image/png"
    },
    {
      "src": "/screenshots/shot2.png",
      "sizes": "1442x3202",
      "type": "image/png"
    }
  ],

  "id": "/?source=pwa",
  
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "url": "/dashboard",
      "icons": [
        { "src": "/icons/layout-dashboard.png", "sizes": "24x24", "type": "image/png" }
      ]
    },
    {
      "name": "My Requests",
      "short_name": "Requests",
      "url": "/dashboard/requests",
      "icons": [
        { "src": "/icons/clipboard-list.png", "sizes": "24x24", "type": "image/png" }
      ]
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "url": "/dashboard/settings",
      "icons": [
        { "src": "/icons/settings.png", "sizes": "24x24", "type": "image/png" }
      ]
    }
  ],

  "file_handlers": [
    {
      "action": "/upload",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg"],
        "video/*": [".mp4", ".mov"]
      }
    }
  ],

  "launch_handler": {
    "client_mode": "focus-existing"
  },

  "protocol_handlers": [
    {
      "protocol": "mailto",
      "url": "mailto:contact@frametoque.online"
    }
  ],

  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.frametoque",
      "id": "com.frametoque"
    }
  ],

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "media", "accept": ["image/*", "video/*"] }
      ]
    }
  },

  "iarc_rating_id": "L-FrameToque-01", 

  "widgets": [
    {
      "src": "/dashboard",
      "name": "FrameToque Dashboard",
      "description": "Quick access to your dashboard and posts",
      "sizes": ["120x120", "240x240"]
    }
  ],

  "edge_side_panel": {
    "src": "/dashboard",
    "enabled": true
  },

  "scope_extensions": ["/dashboard", "/dashboard/settings"]
}
