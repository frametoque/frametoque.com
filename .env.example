# ==============================================================================
# Frametoque - Environment Configuration Template (.env.example)
# Note: Keep all server-only keys secret. Never expose them to client code.
# ==============================================================================

# --- Node Environment ---
NODE_ENV=production

# --- Database (Supabase PostgreSQL Connection Pooling via AWS Singapore) ---
# Format: postgresql://[user]:[password]@[host]:6543/[db]?sslmode=require
DATABASE_URL="postgresql://postgres.xxx:xxx@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"
POSTGRES_URL="postgresql://postgres.xxx:xxx@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"

# --- Authentication (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/login"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/admin"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/admin"

# --- Application-Level Encryption Vault (Server-Only) ---
# 32-byte hexadecimal string for field-level AES-256-GCM encryption
APP_FIELD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
CREDENTIALS_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# --- Cloudflare R2 Object Storage (Primary Media & Document Bucket) ---
R2_ACCOUNT_ID="xxx"
R2_ACCESS_KEY_ID="xxx"
R2_SECRET_ACCESS_KEY="xxx"
R2_BUCKET_NAME="frametoque-com"
R2_PUBLIC_URL="https://pub-xxx.r2.dev"
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-xxx.r2.dev"
NEXT_PUBLIC_PREFER_R2="true"
STORAGE_PROVIDER="r2"

# --- Vercel Blob Storage (Fallback Provider) ---
BLOB_STORE_ID="store_xxx"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# --- Background Cron & Calendar Feed Secrets ---
# Required for /api/cron/social-publisher
CRON_SECRET="your-high-entropy-cron-secret-32-chars-min"
# Required for external ICS calendar subscription (/api/calendar/feed?token=...)
CALENDAR_FEED_SECRET="your-high-entropy-calendar-token-32-chars-min"

# --- AI Integration (Groq SDK) ---
GROQ_API_KEY="gsk_xxx"

# --- Cloudflare Registrar & DNS API (Domain Reselling Control Center) ---
# Default to sandbox in development to prevent real financial transactions.
CLOUDFLARE_ENV="sandbox" # "sandbox" | "production"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_here"
# Optional custom base URL (defaults to https://api.cloudflare.com/client/v4)
CLOUDFLARE_BASE_URL="https://api.cloudflare.com/client/v4"
ALLOW_LIVE_DOMAIN_PURCHASES="false" # Set "true" in production to enable real credit card purchases

# --- Payments Gateway (Payments.lk / OnePay) ---
PAYMENTS_LK_SECRET_KEY="your-payments-lk-api-secret"
PAYMENTS_LK_WEBHOOK_SECRET="your-payments-lk-webhook-signing-secret"

# --- Digital Wallet Invoices (Apple Wallet & Google Wallet) ---
# Apple Wallet Pass (.pkpass)
APPLE_TEAM_ID="your_apple_developer_team_id"
APPLE_PASS_TYPE_ID="pass.com.frametoque.invoice"
APPLE_CERT_P12_BASE64="base64_encoded_p12_certificate"
APPLE_CERT_P12_PASSWORD="your_p12_password"
# Google Wallet Generic Pass
GOOGLE_WALLET_ISSUER_ID="your_google_wallet_issuer_id"
GOOGLE_WALLET_CLIENT_EMAIL="service-account@project.iam.gserviceaccount.com"
GOOGLE_WALLET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Social Media Publisher (Optional Multi-Channel Dispatch) ---
META_ACCESS_TOKEN="your_meta_system_user_token"
FACEBOOK_PAGE_ID="your_facebook_page_id"
INSTAGRAM_ACCOUNT_ID="your_instagram_account_id"
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_channel_or_chat_id"
YOUTUBE_CLIENT_ID="your_youtube_oauth_client_id"
YOUTUBE_CLIENT_SECRET="your_youtube_oauth_client_secret"
YOUTUBE_REFRESH_TOKEN="your_youtube_oauth_refresh_token"

# --- Public Domain & Analytics ---
NEXT_PUBLIC_APP_URL="https://frametoque.com"
NEXT_PUBLIC_UMAMI_WEBSITE_ID="xxx"
UMAMI_URL="https://umami-liart-omega.vercel.app"
UMAMI_USERNAME="admin"
UMAMI_PASSWORD="your_umami_admin_password"
